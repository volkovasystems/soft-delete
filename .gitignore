# Allowlist approach
*
.*

# Allow essential dotfiles
!.gitignore
!.editorconfig

# Allow license
!LICENSE

# Allow documentation
!*.md

# Allow shell scripts
!*.sh
!*.bash
!*.bats

# Allow Ruby and YAML files
!*.rb
!*.yml
!*.yaml

# Allow Makefile (no extension)
!Makefile

# Allow directories
!*/
# But ignore all dotfiles in subdirectories
.*/**/*.*

# Allow same file types in subdirectories
!*/.gitignore
!*/.editorconfig
!*/LICENSE
!*/*.md
!*/*.sh
!*/*.bash
!*/*.bats
!*/Makefile
!*/*.rb
!*/*.yml

# Allow specific new directories
!Formula/
!Formula/**/*
!.github/
!.github/**/*

# Ignore executables without extension (except specific ones)
# Allow our main executable
!bin/soft-delete

# Docker and testing
!Dockerfile.test
!docker-compose.test.yml
!scripts/
!scripts/**/*
!docs/
!docs/**/*

# Ignore test reports but keep structure
reports/*
!reports/.gitkeep
