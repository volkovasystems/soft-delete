# Disable unused variables (sometimes variables are used externally)
disable=SC2034

# Disable not following sourced files (external libraries)
disable=SC1091

# Disable style preference for quoting numeric variables
disable=SC2248

# Disable style preference for brace syntax ${var}
disable=SC2250

# Disable expected single quote behavior in arrays
disable=SC2016

# Disable xargs usage is intentional and safe in our context
disable=SC2038

# Require ${var} instead of $var
enable=require-variable-braces

# Quote variables that could contain spaces
enable=quote-safe-variables

# Check unassigned uppercase variables
enable=check-unassigned-uppercase

# Set shell dialect - we use bash
shell=bash

# External sources - locations where shellcheck should look for sourced files
external-sources=true

# Format output
format=tty

# Severity level (error, warning, info, style)
severity=style
