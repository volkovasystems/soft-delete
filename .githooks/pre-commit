#!/bin/bash

# Pre-commit Hook - Changelog Reminder
# Reminds developers to update the changelog when making commits
# especially for commits that should be documented

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Get the project root
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
CHANGELOG_FILE="$PROJECT_ROOT/CHANGELOG.md"

# Check if this is a merge commit
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    # This is a merge commit, skip changelog check
    exit 0
fi

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

# Skip if only documentation files are being committed
if echo "$STAGED_FILES" | grep -qvE '\.(md|txt|rst|adoc)$'; then
    # Non-documentation files are being committed
    HAS_CODE_CHANGES=true
else
    HAS_CODE_CHANGES=false
fi

# Get commit message if available (for --amend or interactive rebase)
COMMIT_MSG=""
if [[ -f "$PROJECT_ROOT/.git/COMMIT_EDITMSG" ]]; then
    COMMIT_MSG=$(head -n1 "$PROJECT_ROOT/.git/COMMIT_EDITMSG" 2>/dev/null || echo "")
fi

# Function to check if commit should trigger changelog reminder
should_remind_changelog() {
    # Skip for trivial commits
    if [[ "$COMMIT_MSG" =~ ^(docs:|style:|chore:|test:|ci:) ]]; then
        return 1
    fi
    
    # Skip if changelog is being updated in this commit
    if echo "$STAGED_FILES" | grep -q "CHANGELOG.md"; then
        return 1
    fi
    
    # Skip if only version files are being updated
    if [[ "$STAGED_FILES" == "VERSION" ]] || [[ "$STAGED_FILES" == *"package.json"* ]]; then
        return 1
    fi
    
    # Remind for feature/fix commits
    if [[ "$COMMIT_MSG" =~ ^(feat|fix|add|remove|change|security|perf):  ]] || [[ "$HAS_CODE_CHANGES" == true ]]; then
        return 0
    fi
    
    return 1
}

# Function to show changelog reminder
show_changelog_reminder() {
    echo -e "${YELLOW}📝 CHANGELOG REMINDER${NC}"
    echo -e "${BOLD}============================================${NC}"
    echo ""
    echo -e "  ${BLUE}ℹ️  You're making changes that might need changelog documentation.${NC}"
    echo ""
    echo -e "  ${GREEN}Quick commands:${NC}"
    echo -e "    ${BOLD}./scripts/changelog.sh add \"Your change description\" [category]${NC}"
    echo -e "    ${BOLD}./scripts/changelog.sh recent-commits 5${NC} ${BLUE}# See recent commits${NC}"
    echo ""
    echo -e "  ${GREEN}To see what needs to be documented:${NC}"
    echo -e "    ${BOLD}git log --oneline -5${NC}"
    echo ""
    echo -e "  ${GREEN}Categories available:${NC}"
    echo -e "    • ${BOLD}Added${NC}      - New features"
    echo -e "    • ${BOLD}Changed${NC}    - Changes in existing functionality"  
    echo -e "    • ${BOLD}Fixed${NC}      - Bug fixes"
    echo -e "    • ${BOLD}Security${NC}   - Security improvements"
    echo -e "    • ${BOLD}Deprecated${NC} - Soon-to-be removed features"
    echo -e "    • ${BOLD}Removed${NC}    - Removed features"
    echo ""
    echo -e "  ${YELLOW}💡 Tip: The script auto-detects conventional commit formats!${NC}"
    echo -e "      ${BOLD}feat: new feature${NC} → automatically goes to 'Added'"
    echo -e "      ${BOLD}fix: bug fix${NC} → automatically goes to 'Fixed'"
    echo ""
    echo -e "  ${GREEN}Continue with commit?${NC} ${BLUE}(y/N)${NC}"
    
    # Read user input with timeout
    read -t 30 -p "" response || response="y"
    
    case "$response" in
        [yY]|[yY][eE][sS]|"")
            echo -e "${GREEN}✅ Continuing with commit...${NC}"
            echo ""
            return 0
            ;;
        *)
            echo -e "${RED}❌ Commit cancelled. Please update the changelog first.${NC}"
            echo ""
            echo -e "${BLUE}ℹ️  After updating the changelog, run your commit command again.${NC}"
            exit 1
            ;;
    esac
}

# Function to validate changelog format
validate_changelog_if_modified() {
    if echo "$STAGED_FILES" | grep -q "CHANGELOG.md"; then
        echo -e "${BLUE}🔍 Validating changelog format...${NC}"
        
        if [[ -x "$PROJECT_ROOT/scripts/changelog.sh" ]]; then
            if "$PROJECT_ROOT/scripts/changelog.sh" validate >/dev/null 2>&1; then
                echo -e "${GREEN}✅ Changelog format is valid${NC}"
            else
                echo -e "${RED}❌ Changelog format validation failed${NC}"
                echo ""
                echo -e "${BLUE}Run this command to see the issues:${NC}"
                echo -e "${BOLD}  ./scripts/changelog.sh validate${NC}"
                echo ""
                exit 1
            fi
        fi
    fi
}

# Function to run AI agent protection checks
run_functionality_preservation_check() {
    echo -e "${BLUE}🛡️  Running AI Agent Protection Checks...${NC}"
    
    # 1. Functionality preservation check
    if [[ -x "$PROJECT_ROOT/scripts/functionality-guard.sh" ]]; then
        if ! "$PROJECT_ROOT/scripts/functionality-guard.sh" --pre-commit >/dev/null 2>&1; then
            echo ""
            echo -e "${RED}🚫 COMMIT BLOCKED: Functionality regression detected!${NC}"
            echo ""
            "$PROJECT_ROOT/scripts/functionality-guard.sh" --pre-commit
            echo ""
            echo -e "${RED}This typically happens when AI agents recreate scripts from scratch${NC}"
            echo -e "${RED}instead of making incremental edits to preserve existing functions.${NC}"
            echo ""
            echo -e "${YELLOW}To bypass (NOT recommended): git commit --no-verify${NC}"
            echo ""
            exit 1
        fi
    fi
    
    # 2. Quick security check
    if [[ -x "$PROJECT_ROOT/scripts/security-scan.sh" ]]; then
        if ! "$PROJECT_ROOT/scripts/security-scan.sh" --quiet >/dev/null 2>&1; then
            echo ""
            echo -e "${RED}🚫 COMMIT BLOCKED: Security issues detected!${NC}"
            echo ""
            echo -e "${YELLOW}Run this to see issues: ./scripts/security-scan.sh --quiet${NC}"
            echo -e "${YELLOW}To fix automatically: ./scripts/security-scan.sh --fix${NC}"
            echo -e "${YELLOW}To bypass (NOT recommended): git commit --no-verify${NC}"
            echo ""
            exit 1
        fi
    fi
    
    # 3. Check for potential secrets in staged changes
    staged_secrets=$(git diff --cached | grep -E "(password|api[_-]?key|secret|token)\s*=\s*['\"][^'\"]{3,}" || true)
    
    if [[ -n "$staged_secrets" ]]; then
        echo ""
        echo -e "${RED}🚫 COMMIT BLOCKED: Potential secrets detected!${NC}"
        echo ""
        echo -e "${RED}Found potential secrets in staged changes:${NC}"
        echo "$staged_secrets"
        echo ""
        echo -e "${YELLOW}Remove secrets or add [REDACTED] markers for examples${NC}"
        echo -e "${YELLOW}To bypass (NOT recommended): git commit --no-verify${NC}"
        echo ""
        exit 1
    fi
    
    echo -e "${GREEN}✅ AI Agent Protection checks passed${NC}"
}

# Main logic
main() {
    # Run AI agent protection checks first (most critical)
    run_functionality_preservation_check
    
    # Always validate changelog if it's being modified
    validate_changelog_if_modified
    
    # Show reminder for significant changes
    if should_remind_changelog; then
        show_changelog_reminder
    fi
    
    # All checks passed
    exit 0
}

# Only run if we're in a git repository
if git rev-parse --git-dir >/dev/null 2>&1; then
    main
fi
